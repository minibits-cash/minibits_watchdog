# ── Watchdog's own database ───────────────────────────────────────────────────
# Separate Postgres instance from the mint, so watchdog storage and load cannot
# affect the mint, and so watchdog survives (and can alert on) mint DB failure.
DATABASE_URL="postgresql://watchdog:password@localhost:5432/minibits_watchdog"

# ── CDK mint database (READ-ONLY role) ────────────────────────────────────────
# Role must have SELECT only. Recommended setup on the mint's Postgres:
#   CREATE ROLE watchdog_ro LOGIN PASSWORD '...';
#   GRANT CONNECT ON DATABASE <mintdb> TO watchdog_ro;
#   GRANT USAGE ON SCHEMA public TO watchdog_ro;
#   GRANT SELECT ON ALL TABLES IN SCHEMA public TO watchdog_ro;
#   ALTER ROLE watchdog_ro SET default_transaction_read_only = on;
#   ALTER ROLE watchdog_ro SET statement_timeout = '30s';
MINT_DATABASE_URL="postgresql://watchdog_ro:password@localhost:5432/cdk_mint"

# ── CDK mint management gRPC (BDK wallet balance) ─────────────────────────────
# cdk-mintd's [mint_management_rpc] listener. Read for ONE thing: the mint's
# on-chain BDK wallet balance, via the read-only WalletService.
#
# ⚠ Leaving this empty is a real blind spot, not a smaller feature set. Without
# it, mint on-chain reserves are inferred from CDK's own ledger — the same books
# this tool audits — so the figure moves only when CDK writes a row. Coins
# leaving the wallet by any route CDK did not book (a manual sweep, an unbooked
# fee, a bug) do not move it at all. Undeclared outflow is the thing the watchdog
# exists to catch, and the ledger basis is structurally unable to express one.
# The startup banner states which basis is in use, and warns on the estimate.
#
# Verify before deploying:  yarn probe:mint-rpc
# It prints the wallet balance beside the ledger estimate. Their difference is a
# ONE-OFF step in own capital at the changeover; over ~96,000 sat it will trip
# reserve_drift_long once and then age out of the 48h window by itself.
#
# The listener binds inside the mint's network namespace. In a container,
# address = "127.0.0.1" is reachable only from inside it — publish the port or
# bind it to the container's interface, then reach it from here.
#
# ⚠ The same endpoint also serves CDK's WRITE-CAPABLE management service, and
# gRPC has no per-method credential to scope that away — this cannot be the
# equivalent of LND's readonly.macaroon. The mitigation is reach: only the
# read-only WalletService is compiled into the watchdog, so it has no stub for a
# management method, and the listener should stay on loopback or behind a tunnel.
MINT_RPC_HOST=
MINT_RPC_PORT=8086
MINT_RPC_TIMEOUT_MS=5000

# Sent as the `x-cdk-protocol-version` header, which cdk-mintd requires on every
# request and compares by EXACT STRING — not semver, so a patch bump on CDK's
# side breaks the call outright. Its rejection names the version it wants, so on
# a mismatch read it out of the alert and set it here; that beats waiting on a
# watchdog release while reserve monitoring is dark.
MINT_RPC_PROTOCOL_VERSION=1.0.0

# Mutual TLS, when cdk-mintd is configured with `tls_dir` rather than
# `allow_insecure`. Paths to PEM files, all three or none — cdk-mintd
# authenticates the client, so a CA without a client keypair fails the
# handshake. Leave empty on loopback or through an SSH tunnel, where the
# transport is already secured.
MINT_RPC_TLS_CA=
MINT_RPC_TLS_CLIENT_CERT=
MINT_RPC_TLS_CLIENT_KEY=

# ── Mint on-chain minimum receive amount ──────────────────────────────────────
# Must match the mint's `[bdk] min_receive_amount_sat`, in sat.
#
# A confirmed deposit below it is NEVER credited. CDK's check is
# `amount_sat < min_receive_amount_sat` on the individual receive and it ignores
# what the quote already holds, so a small top-up to a well-funded quote is
# refused exactly like a first payment. Verified against production: 18 on-chain
# payments booked, smallest exactly 10,000, none below.
#
# Such deposits can never become ecash, so the mint owes nobody for them and they
# are booked straight to own capital instead of waiting in unclaimed for an event
# that cannot happen. Each one raises `mint_onchain_dust_deposit` ONCE on arrival.
#
# ⚠ Use the BDK setting, not the mint's advertised minimum. They coincide on this
# mint and need not on yours.
#
# Setting it wrong is safe by construction. `dustReceived` is a live set, so a
# deposit CDK does credit leaves it at the same moment it enters `unclaimed`, and
# the two cancel in `remaining delta`. Zero disables the classification: every
# deposit is then treated as potentially creditable and held in unclaimed.
MINT_ONCHAIN_MIN_RECEIVE_SAT=0

# ── bitcoind (deposit attribution) ────────────────────────────────────────────
# Used for exactly one question: which addresses did a given transaction pay?
#
# That is what separates a user paying an on-chain mint quote — a liability the
# mint owes ecash against — from the operator moving liquidity into the wallet,
# which owes nobody anything. CDK's wallet RPC cannot answer it: WalletTransaction
# carries no output addresses and WalletAddress carries no txids, so there is no
# join between the two.
#
# ~2 calls per deposit, cached forever after: which addresses a confirmed
# transaction paid never changes. At the observed rate that is a handful a day.
#
# Works WITHOUT -txindex. The lookup passes the block hash for the confirmation
# height CDK already reports, and bitcoind will find any transaction when told
# which block to look in.
#
# A public explorer would also work and would not strain any free tier — but it
# would disclose the mint's reserve wallet deposit graph, and through the request
# timing, that you are the recipient. bitcoind is already present for CDK's BDK
# backend, so the private answer is also the authoritative one.
#
# OPTIONAL, and orthogonal to MINT_ONCHAIN_MIN_RECEIVE_SAT above — dust is
# classified by amount and needs no chain access at all.
#
# Unset, a deposit at or above the minimum cannot be attributed to a quote, so it
# is held as unclaimed indefinitely. That is conservative and cannot cause a false
# shortfall, but operator liquidity then sits in the mint's liabilities until CDK
# books something, and co-spend detection is off entirely since it needs inputs.
BITCOIN_RPC_URL=
BITCOIN_RPC_USER=
BITCOIN_RPC_PASSWORD=
# Alternative to user/password; takes precedence when set. Re-read whenever the
# file changes, since bitcoind rewrites it on every restart.
BITCOIN_RPC_COOKIE=
BITCOIN_RPC_TIMEOUT_MS=5000

# Unit backed by the Lightning node. Reconciliation only runs for this unit.
BACKING_UNIT=sat

# ── Reserves held outside the Lightning node ──────────────────────────────────
# Operator-declared, in sat. Added to the asset side so moving funds to cold
# storage does not read as a shortfall.
#
# Changing this value is treated as a DECLARED movement and excluded from
# `remaining delta`, so editing it raises no false drift alert (verified:
# +1,000,000 here produced Δ total difference +1,000,000 and remaining delta 0).
#
# ⚠ The window between moving the coins and updating this number is a real,
# undeclared outflow, and the watchdog WILL alert on it. That is intended — an
# undeclared movement of funds off the node is exactly what this tool is for.
# Update this value in the same maintenance window as the transfer.
COLD_STORAGE_RESERVES=0


# ── Issued ecash that can never be redeemed ───────────────────────────────────
# Operator-declared, in sat. Promises the mint has issued but which are known to
# be permanently unspendable — typically stranded by a migration to a mint
# implementation that cannot spend them.
#
# `issued − redeemed` counts these as a liability the mint will never settle, so
# without this the mint looks permanently under-capitalised by a fixed amount.
#
# Added to OWN CAPITAL rather than deducted from `ecash issued`. The arithmetic
# is identical, but this way `ecash issued` stays exactly what the mint database
# reports and remains checkable against it — a measurement and a declaration are
# never blended into one figure.
#
# Changing this value is treated as a DECLARED movement and excluded from
# `remaining delta`, so revising the figure raises no false drift alert.
#
# ⚠ Only for ecash that is provably unspendable. Anything merely dormant or
# unclaimed does NOT belong here — those are already tracked separately, and
# declaring them would permanently overstate equity.
PROVABLY_UNSPENDABLE_ECASH=0


# ── Sources enabled on this instance ──────────────────────────────────────────
# Comma-separated: lnd, mint. Defaults to both.
# A source's credentials are required only when it is enabled. Disabling must be
# explicit — an accidentally missing macaroon in production has to fail loudly
# rather than quietly leave the node unmonitored.
ENABLED_SOURCES=lnd,mint

# ── LND ───────────────────────────────────────────────────────────────────────
# Use readonly.macaroon. The watchdog never writes to LND, so a read-only
# credential means a compromised watchdog cannot move funds.
#
# BOTH values must be HEX (not PEM, not base64):
#   xxd -ps -u -c 10000 readonly.macaroon
#   xxd -ps -u -c 10000 tls.cert
#
# Use `localhost` rather than 127.0.0.1 when tunnelling: gRPC derives the TLS
# ServerName from this value, and RFC 6066 forbids an IP address there (Node
# warns today and will reject it eventually). lnd's autogenerated cert carries
# a DNS:localhost SAN, so the hostname validates cleanly.
#
# If the handshake fails, the cert is missing the SAN you need. Note that
# `tlsextraip` / `tlsextradomain` only apply when lnd *generates* the cert, and
# it only generates when tls.cert/tls.key are absent — editing lnd.conf alone
# changes nothing. Regenerating also invalidates the cert held by any other
# client (minibits_server), so it needs coordinating. Never disable
# certificate verification.
LND_HOST=localhost
LND_PORT=10009
LND_READONLY_MACAROON=
LND_TLS_CERT=

# ── Collection ────────────────────────────────────────────────────────────────
COLLECT_INTERVAL_MS=300000        # 5 minutes
COLLECT_SOURCE_TIMEOUT_MS=20000   # per-source timeout; one slow source must not stall the tick

# ── Notifications ─────────────────────────────────────────────────────────────
#
# Comma-separated list of active transports: ntfy, email. Empty means alerts
# still fire and are recorded, but never leave the machine — the startup banner
# warns when that is the case.
#
# Enabling more than one gives delivery redundancy: the send succeeds if ANY
# transport succeeds, and a partial failure is recorded as an Event so a broken
# secondary channel cannot hide behind a working primary.
ENABLED_NOTIFIERS=ntfy,email

# ⚠ PRIVACY — alert text carries the mint's reserve figures, channel balances,
# pending proof totals and force-close events.
#
#   - Public ntfy.sh topics are unauthenticated: anyone who knows or guesses the
#     topic reads every alert, and history cannot be revoked.
#   - SMTP is encrypted hop-by-hop, NOT end to end. The destination mailbox
#     provider sees plaintext.
#
# With this on, amounts are replaced by *** before sending. Severity, rule and
# subject survive, so alerts still convey urgency and point at what to look at —
# the figures are then read from the dashboard over the SSH tunnel.
#
# Set per transport, because the exposures genuinely differ — an unauthenticated
# public ntfy topic is readable by anyone who guesses it, whereas a mailbox on
# your own domain is not.
#
# Both default to TRUE when unset. Disclosure should be a deliberate act, so a
# missing or misspelled variable errs toward privacy.
NTFY_REDACT_AMOUNTS=true
EMAIL_REDACT_AMOUNTS=true

# ── ntfy ──────────────────────────────────────────────────────────────────────
# Treat the topic as a secret, not a name: `openssl rand -hex 16`.
# Self-hosting ntfy and pointing NTFY_URL at it removes the third party entirely.
NTFY_URL=https://ntfy.sh
NTFY_TOPIC=
NTFY_TOKEN=                       # optional, for self-hosted or protected topics

# ── Email (SMTP) ──────────────────────────────────────────────────────────────
# Note: SMTP returning "250 Accepted" does not mean the mail was read — it can
# still be filed as spam. That is a silent failure the deadman's switch cannot
# detect, because delivery genuinely succeeded. Treat email as a secondary
# channel alongside push rather than the only one, and check that the first real
# alert actually arrives in the inbox.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false                 # true for implicit TLS on port 465
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
EMAIL_TO=                         # comma-separated for multiple recipients

# ── Deadman's switch ──────────────────────────────────────────────────────────
#
# Two independent channels; either or both may be used.
#
# 1. LOG MARKERS — always emitted, no configuration needed.
#
#    Single-line JSON on stdout, written directly rather than through the
#    logger, so raising LOG_LEVEL cannot suppress the liveness signal:
#
#      {"marker":"WATCHDOG_HEARTBEAT_OK","ts":"...","observationId":20,
#       "lnd":"OK","mint":"OK","durationMs":955}
#      {"marker":"WATCHDOG_HEARTBEAT_FAIL","ts":"...","detail":"..."}
#
#    ⚠ THE ABSENCE RULE IS THE ONE THAT MATTERS. A crashed, hung, OOM-killed or
#    host-failed watchdog emits NO log line at all — there is no ERROR to match,
#    only silence. Configure the log analyser with BOTH:
#
#      (a) ABSENCE: no WATCHDOG_HEARTBEAT_OK seen in 3× COLLECT_INTERVAL_MS
#          (15 minutes at the default 5-minute cadence) → CRITICAL.
#          This is the actual deadman's switch.
#      (b) PRESENCE: any WATCHDOG_HEARTBEAT_FAIL → CRITICAL.
#          Catches failures the watchdog is still alive enough to report:
#          a tick that could not be persisted, notifications undeliverable on
#          every transport, an uncaught exception on the way down.
#
#    Rule (b) alone is NOT a deadman's switch. It cannot detect the failure it
#    most needs to.
#
# 2. HTTP PING — optional, set HEARTBEAT_URL. healthchecks.io convention:
#    <URL> on success, <URL>/fail on a problem. Works with self-hosted
#    Healthchecks. Leave empty to rely on log markers alone.
HEARTBEAT_URL=

# ── Server ────────────────────────────────────────────────────────────────────
# Bound to loopback only — the dashboard has no auth and is reached over an SSH
# tunnel. Do not change to 0.0.0.0.
HOST=127.0.0.1
PORT=3005
CORS_ORIGIN=http://localhost:3006

LOG_LEVEL=info
