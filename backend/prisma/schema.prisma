// Minibits Watchdog — see SPEC.md §5
//
// All monetary columns are BigInt msat. Every raw source field is persisted
// verbatim so a derivation error stays repairable across existing history
// (SPEC.md §3.5) — derived values live in Reconciliation, never overwriting
// what was actually observed.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SourceStatus {
  OK
  UNREACHABLE
  ERROR
  TIMEOUT
  SKIPPED
}

/// One coherent observation across all sources.
///
/// All sources are read as close together as possible and share a single
/// observedAt, with the actual spread recorded in skewMs. Reconciling values
/// read minutes apart would be meaningless.
///
/// A row is written even when a source fails, with the snapshot absent and the
/// status set — a gap must be distinguishable from "nothing happened".
model Observation {
  id         Int      @id @default(autoincrement())
  observedAt DateTime
  skewMs     Int      @default(0)
  durationMs Int      @default(0)

  lndStatus  SourceStatus
  mintStatus SourceStatus

  lndError  String?
  mintError String?

  lnd            LndSnapshot?
  mints          MintSnapshot[]
  reconciliation Reconciliation?

  createdAt DateTime @default(now())

  @@index([observedAt])
}

/// Raw LND telemetry, stored verbatim. Node-level, so one row per observation.
model LndSnapshot {
  id            Int         @id @default(autoincrement())
  observationId Int         @unique
  observation   Observation @relation(fields: [observationId], references: [id], onDelete: Cascade)

  // ChannelBalanceResponse
  channelLocal            BigInt
  channelRemote           BigInt
  channelUnsettledLocal   BigInt
  channelUnsettledRemote  BigInt
  channelPendingOpenLocal BigInt
  channelPendingOpenRemote BigInt

  // WalletBalanceResponse
  onchainTotal         BigInt
  onchainConfirmed     BigInt
  onchainUnconfirmed   BigInt
  onchainLocked        BigInt
  onchainReservedAnchor BigInt

  // PendingChannelsResponse
  limbo                  BigInt
  pendingOpenCount       Int
  pendingForceCloseCount Int
  waitingCloseCount      Int

  // GetInfoResponse
  blockHeight         Int
  syncedToChain       Boolean
  syncedToGraph       Boolean
  numActiveChannels   Int
  numInactiveChannels Int
  numPendingChannels  Int
  version             String

  /// Full unmodified responses, for retroactive re-derivation.
  raw Json

  @@index([observationId])
}

/// Mint telemetry, one row per unit per observation (reconciliation is per-unit).
model MintSnapshot {
  id            Int         @id @default(autoincrement())
  observationId Int
  observation   Observation @relation(fields: [observationId], references: [id], onDelete: Cascade)

  unit String

  // keyset_amounts — CDK's running ledger (the cheap per-tick read)
  issued       BigInt
  redeemed     BigInt
  feeCollected BigInt

  // proof table — PENDING only. Unspent/spent totals are not collected per tick:
  // they need a full scan of the large proof table, and `outstanding` and
  // `redeemed` above already carry the same information from keyset_amounts.
  // They are verified instead by the weekly ledger drift check (§4.2).
  proofsPending      BigInt
  proofsPendingCount Int

  // Derived from the append-only ledger tables (sum of payments − sum of
  // issuance), not from mint_quote, which has no index for the predicate.
  // The count is nullable because the ledgers cannot supply one: storing 0
  // would assert "none" where we mean "not measured".
  unclaimedMintQuotes      BigInt
  unclaimedMintQuotesCount Int?
  /// On-chain share of unclaimedMintQuotes — already inside it, not an extra term.
  /// From mint_quote.amount_paid − amount_issued; the total is ledger-derived, as
  /// the ledger tables carry no payment_method column.
  /// Nullable for the same reason as the count above: rows written before this was
  /// collected must read "not measured", not "none on-chain" — otherwise the
  /// dashboard would assert "all on Lightning" off a backfilled default.
  unclaimedOnchain         BigInt?
  /// amount_issued > amount_paid: ecash issued against an unpaid quote. Must be 0.
  overIssuedMintQuotes     BigInt

  // melt_quote — stuck-melt detection, NOT a reconciliation term
  pendingMeltQuotes      BigInt
  pendingMeltQuotesCount Int
  meltFeeReserve         BigInt

  // transient operation tables
  sagasInFlight            Int
  meltRequestsInFlight     Int
  meltRequestsInputsAmount BigInt

  // On-chain reserves as CDK's ledger implies them: paid on-chain mint quotes,
  // less booked melt payouts, less broadcast-but-unsettled melts.
  //
  // No longer the reserve figure when the wallet RPC is configured — it verifies
  // internal consistency, not custody, because it reads the same books the
  // watchdog audits. Still collected, because its DIVERGENCE from the measured
  // wallet balance below is exactly the class of movement CDK never booked.
  onchainBalance   BigInt @default(0)
  onchainDeposits  BigInt @default(0)
  onchainWithdrawn BigInt @default(0)
  onchainQuotes    Int    @default(0)

  /// Committed-but-unsettled on-chain melts, ALREADY subtracted from onchainBalance.
  /// Part of the wallet-balance estimate, not a reconciliation term: the outgoing
  /// tx has left the wallet but completed_operations has no row until settlement.
  /// Lightning needs no equivalent — LND's local_balance drops at HTLC send.
  /// Nullable: rows written before this was collected are "not measured", not zero.
  onchainInflight           BigInt?
  onchainInflightCount      Int?
  /// In flight beyond INFLIGHT_MELT_MAX_AGE_SEC — reported, NOT subtracted.
  onchainInflightStale      BigInt?
  onchainInflightStaleCount Int?
  /// Age of the oldest in-flight on-chain melt, seconds. Drives the stuck-melt rule.
  onchainInflightOldestSec  Int?

  // ── BDK wallet, measured over CDK's management gRPC (WalletService) ─────────
  //
  // The authoritative on-chain reserve figure once MINT_RPC_HOST is set. Unlike
  // the ledger columns above, these can express a movement CDK never wrote a row
  // for — an operator sweep, an unbooked fee, a bug — which is the whole reason
  // to prefer them.
  //
  // All nullable, and null means "not measured this tick": either the RPC is not
  // configured, or the call failed. Zero would assert an empty wallet, and the
  // difference between an empty wallet and an unread one is the difference
  // between a solvency alert and a connectivity one.
  //
  /// Confirmed and spendable.
  walletConfirmed        BigInt?
  /// Unconfirmed change from the wallet's own transactions — ours, just not mined.
  walletTrustedPending   BigInt?
  /// Unconfirmed inbound from elsewhere. NOT counted in reserves: still reversible,
  /// and CDK has not credited the mint quote for it either, so counting it would
  /// raise assets with no matching liability and read as unexplained drift.
  walletUntrustedPending BigInt?
  /// Immature coinbase. Structurally zero for a mint; collected so a non-zero
  /// value is visible rather than assumed away.
  walletImmature         BigInt?
  /// confirmed + trustedPending. This is what reconciliation uses.
  walletTrustedSpendable BigInt?
  /// Everything the wallet can see, including untrusted pending.
  walletTotal            BigInt?
  /// "bitcoin", "signet", … A mismatch means the watchdog is reading a wallet
  /// that has nothing to do with the reserves it is reporting on.
  walletNetwork          String?

  /// Confirmed deposits the mint owes ecash for, which CDK has not yet booked as
  /// `amount_paid`. A liability — see Reconciliation.depositsAwaitingCredit.
  depositsAwaitingCredit      BigInt?
  depositsAwaitingCreditCount Int?
  /// Confirmed deposits with NO matching mint quote: operator liquidity moved
  /// into the wallet. Explicitly NOT a liability — the mint owes ecash to nobody
  /// for these — so they raise own capital rather than unclaimed.
  depositsUnattributed        BigInt?
  depositsUnattributedCount   Int?
  /// Confirmed deposits below the mint's `min_receive_amount_sat`, which CDK will
  /// never credit. Own capital on sight — the mint owes ecash to nobody for them.
  depositsDust                BigInt?
  depositsDustCount           Int?

  /// The wallet's own chain tip. Cross-checked against LND's height, which comes
  /// from a completely independent node — a stalled BDK sync reports a stale
  /// balance perfectly confidently, and nothing else would reveal it.
  walletSyncedHeight     Int?

  keysetsActive Int
  keysetsTotal  Int

  /// Per-keyset issued/redeemed/fees for the dashboard drill-down.
  /// JSON rather than a child table: three rows per observation would triple the
  /// row count for data no rule queries. Promote to a table if a keyset-level
  /// rule ever needs it.
  keysetBreakdown Json?

  raw Json

  @@unique([observationId, unit])
  @@index([unit])
}

/// Derived reconciliation for the backing unit. See SPEC.md §3.
///
/// Levels only — windowed rates are computed at query time so a change to the
/// window definitions does not require recollecting or rewriting history.
model Reconciliation {
  id            Int         @id @default(autoincrement())
  observationId Int         @unique
  observation   Observation @relation(fields: [observationId], references: [id], onDelete: Cascade)

  unit String

  /// Channel + Wallet + Limbo. Measured from LND — kept free of declared values.
  totalNodeBalance BigInt
  /// Operator-declared reserves held outside the node (COLD_STORAGE_RESERVES).
  coldStorage      BigInt @default(0)
  /// On-chain reserves in the mint's own BDK wallet — the figure actually used.
  /// Its basis is recorded alongside, because the two are not interchangeable.
  mintOnchain      BigInt @default(0)
  /// Which measurement mintOnchain came from: "WALLET" (BDK, measured over gRPC)
  /// or "LEDGER" (inferred from CDK's books).
  ///
  /// Recorded rather than inferred from config, so history stays readable after
  /// the switch: the changeover puts a one-off step in ownCapital equal to the
  /// divergence between the two bases, and a year from now this column is the
  /// only thing that explains it. Null on rows written before the column existed.
  mintOnchainBasis String?
  /// The ledger-derived figure, kept even when it is not the basis.
  ///
  /// Its gap to the measured wallet balance is the alertable quantity: on-chain
  /// fees CDK never booked, deposits to the wallet outside any mint quote, and
  /// coins moved out by hand all live in that gap and nowhere else.
  mintOnchainLedger BigInt?
  /// issued − redeemed. Purely measured — declared adjustments never fold in here.
  mintBalance      BigInt
  /// Operator-declared issued ecash that can never be redeemed
  /// (PROVABLY_UNSPENDABLE_ECASH), e.g. promises stranded by a mint migration.
  /// Added to own capital rather than deducted from mintBalance, so the measured
  /// liability stays audit-able against the mint database. Arithmetically the same.
  provablyUnspendable BigInt @default(0)
  proofsPending    BigInt
  /// The mint's own capital: reserves in excess of what it owes.
  /// totalNodeBalance + coldStorage − mintBalance + proofsPending
  /// (called "Total difference" in the original tracking spreadsheet)
  ownCapital       BigInt
  unclaimed        BigInt

  /// On-chain deposits confirmed in the BDK wallet that CDK has not yet booked
  /// as `amount_paid`.
  ///
  /// The mint owes ecash for these the moment they confirm, but `unclaimed` is
  /// derived from CDK's books and cannot know that yet. Without this term the
  /// asset is recognised before the matching liability, and any window starting
  /// inside the lag sees the ecash created against a deposit it never saw
  /// arrive — measured at −420,000 sat on 2026-08-16, a false CRITICAL.
  ///
  /// Subtracted in remainingDelta exactly like `unclaimed`, because it IS
  /// unclaimed; the two differ only in which side of CDK's bookkeeping they sit.
  /// Kept as its own column rather than folded in so `unclaimed` stays a pure
  /// reading of the mint database.
  depositsAwaitingCredit BigInt @default(0)

  /// Confirmed on-chain deposits below the mint's minimum receive amount.
  ///
  /// CDK's check is on the individual receive and ignores what the quote already
  /// holds, so these can never become ecash. Not a liability: the mint owes nobody
  /// for them, so they are own capital from the moment they confirm rather than
  /// being parked in unclaimed awaiting an event that cannot happen.
  ///
  /// Subtracted in remainingDelta as EXPLAINED, which also makes a mis-set
  /// MINT_ONCHAIN_MIN_RECEIVE_SAT self-correcting: this is a live set, so a
  /// deposit CDK does credit leaves it at the same moment it enters `unclaimed`,
  /// and the two movements cancel instead of reading as a shortfall.
  dustReceived           BigInt @default(0)

  /// Cumulative mint input fees (keyset_amounts.fee_collected).
  ///
  /// Mint fees are taken by BURNING the wallet's ecash: inputs exceed outputs, so
  /// `issued − redeemed` falls while reserves are untouched. Fee income therefore
  /// arrives *as* own capital rather than as a separate asset. Distinct from
  /// Lightning routing income, which is not separately measurable.
  mintFeesCollected BigInt @default(0)

  // Differences against the immediately preceding reconciliation, mirroring the
  // manual sheet. Null on the first row and whenever the previous observation
  // was incomplete.
  prevObservationId Int?
  elapsedMs         Int?
  deltaOwnCapital   BigInt?
  deltaUnclaimed    BigInt?
  /// Change in deposits awaiting credit. Subtracted alongside deltaUnclaimed —
  /// the two are the same liability either side of CDK booking it, so a deposit
  /// moving from one to the other must net to zero.
  deltaDepositsAwaitingCredit BigInt?
  /// Change in dust received. Subtracted for the same reason as the term above.
  deltaDustReceived           BigInt?
  /// Change in declared cold-storage reserves. Subtracted below because an
  /// operator-declared movement is *explained* — without this, editing
  /// COLD_STORAGE_RESERVES would step ownCapital and read as drift.
  deltaColdStorage  BigInt?
  /// Change in declared unspendable ecash. Subtracted for the same reason as
  /// cold storage: revising the declaration is explained, not drift.
  deltaProvablyUnspendable BigInt?
  /// Change in cumulative mint fees. Subtracted because it is explained income.
  ///
  /// Not merely tidiness: fee income can MASK a leak. Earning +X while something
  /// drains −X leaves remainingDelta at zero and the mint looking healthy.
  /// Removing known income exposes the drain.
  deltaMintFees     BigInt?
  /// deltaOwnCapital − deltaUnclaimed − deltaColdStorage − deltaMintFees.
  /// The alertable number: change in own capital that nothing explains.
  remainingDelta    BigInt?

  createdAt DateTime @default(now())

  @@index([unit, createdAt])
}

enum AlertStatus {
  /// Condition seen, but has not yet held for `forEvaluations`. Never notified.
  /// Distinct from RESOLVED so a not-yet-fired alert is not misread as one that
  /// fired and recovered.
  PENDING
  FIRING
  RESOLVED
}

enum Severity {
  INFO
  WARNING
  CRITICAL
}

/// Current state of one rule instance. See SPEC.md §7.
///
/// Keyed by (ruleId, dedupeKey) so a rule can track several independent
/// subjects — one stuck melt quote per row, for instance — without collapsing
/// them into a single alert.
model AlertState {
  id        Int    @id @default(autoincrement())
  ruleId    String
  dedupeKey String

  status   AlertStatus
  severity Severity

  title  String
  detail String?

  /// Consecutive evaluations the condition has held. Gates the `for` duration.
  consecutiveHits   Int @default(0)
  consecutiveMisses Int @default(0)

  firstSeenAt    DateTime
  lastEvaluatedAt DateTime
  firedAt        DateTime?
  resolvedAt     DateTime?
  lastNotifiedAt DateTime?
  notifyCount    Int       @default(0)

  context Json?

  events AlertEvent[]

  @@unique([ruleId, dedupeKey])
  @@index([status])
}

enum AlertEventKind {
  FIRED
  RESOLVED
  RENOTIFIED
  NOTIFY_FAILED
}

/// Append-only history of alert transitions and delivery attempts.
model AlertEvent {
  id           Int            @id @default(autoincrement())
  alertStateId Int
  alertState   AlertState     @relation(fields: [alertStateId], references: [id], onDelete: Cascade)

  kind    AlertEventKind
  at      DateTime       @default(now())
  detail  String?
  context Json?

  @@index([alertStateId, at])
}

/// Per-rule tuning, seeded from code defaults so thresholds change without a redeploy.
model RuleConfig {
  id     Int     @id @default(autoincrement())
  ruleId String  @unique

  enabled  Boolean  @default(true)
  severity Severity @default(WARNING)

  /// Evaluations the condition must hold before firing.
  forEvaluations Int @default(2)
  /// Evaluations the condition must be absent before resolving (hysteresis).
  clearEvaluations Int @default(2)
  /// Minimum seconds between repeat notifications while still firing.
  cooldownSeconds Int @default(3600)

  /// Whether clearing sends a notification.
  ///
  /// True for STATE rules — "LND is unreachable" resolving is worth knowing.
  /// False for EVENT rules, where the condition describes something that
  /// happened rather than something that is ongoing: a collection gap or a
  /// keyset rotation has nothing to "clear", so a resolution notice is pure
  /// noise and doubles the cost of every occurrence.
  notifyOnResolve Boolean @default(true)

  /// Rule-specific thresholds.
  params Json @default("{}")

  updatedAt DateTime @updatedAt

  @@index([enabled])
}

/// Running totals over the mint's append-only ledger tables.
///
/// `mint_quote` has no index supporting `amount_paid > amount_issued`, so
/// computing "Total unclaimed" from it costs a full scan of a large, wide table —
/// impossible every
/// five minutes. `mint_quote_payments` and `mint_quote_issued` are narrow,
/// append-only, and keyed by a monotonic integer PK, so the same figure comes
/// from `sum(payments) − sum(issued)` at O(new rows) per tick after one initial
/// pass.
///
/// `frozenUpToId` deliberately lags `max(id)` by an overlap window. A sequence
/// assigns ids before commit, so a lower id can commit *after* a higher one;
/// without the lag, such a row would be skipped permanently. The overlap
/// segment is recomputed every tick, so late commits inside it are picked up.
model LedgerWatermark {
  id     Int    @id @default(autoincrement())
  ledger String @unique

  /// Rows with id <= this are fully accounted for in frozenTotal.
  frozenUpToId BigInt @default(0)
  frozenTotal  BigInt @default(0)

  updatedAt DateTime @updatedAt
}

/// Mint quotes settled on-chain rather than over Lightning.
///
/// Cached here so the per-tick sum is a set of primary-key lookups against
/// `mint_quote` rather than a scan for `payment_method='onchain'`, which has no
/// supporting index on a large table.
///
/// Discovery is watermarked on `created_time`, which is safe because creation
/// time never changes — unlike `amount_paid`, which is why the amount itself is
/// re-read every tick instead of being cached.
model MintOnchainQuote {
  id          Int      @id @default(autoincrement())
  quoteId     String   @unique
  createdTime Int
  discoveredAt DateTime @default(now())

  @@index([createdTime])
}

/// Transactions of the mint's BDK wallet, cached with their classification.
///
/// Cached rather than recomputed because classification costs a chain lookup and
/// the answer never changes: which addresses a confirmed transaction paid is
/// settled forever once it is in a block. At the observed rate (~3 inbound per
/// day) the steady-state cost is a handful of lookups a day.
///
/// The classification is what makes the reconciliation identity hold across an
/// on-chain deposit. Value entering the wallet is one of three things, and they
/// have completely different accounting:
///
///   MINT_QUOTE   — paid to an address belonging to an on-chain mint quote. The
///                  mint owes ecash for it, so it counts as unclaimed from the
///                  moment it confirms, NOT from when CDK gets round to booking
///                  it. That lag was 15 minutes on 2026-08-16 and produced a
///                  false CRITICAL six hours later.
///   UNATTRIBUTED — no matching quote. Operator liquidity, from outside the
///                  monitored perimeter or from the LND wallet. No liability, so
///                  it must never touch unclaimed.
///   PENDING      — not classified yet: no chain source configured, or the
///                  lookup failed. Treated as MINT_QUOTE for a bounded period,
///                  which is the conservative direction.
model MintWalletTx {
  txid String @id

  receivedSat     BigInt
  sentSat         BigInt
  balanceDeltaSat BigInt

  confirmationHeight Int?
  confirmationTime   Int?

  /// When the watchdog first saw it. Drives the large-movement events, which
  /// must fire once on arrival rather than for as long as the row exists.
  firstObservedAt DateTime @default(now())

  /// PENDING | MINT_QUOTE | UNATTRIBUTED | OUTGOING
  classification String  @default("PENDING")
  /// Txids this transaction spent from. Outgoing transactions only.
  ///
  /// Exists to detect a dusting attack completing. Deposit addresses are free to
  /// harvest — on-chain mint quotes are unauthenticated, so anyone can request
  /// one and be handed a fresh address without any xpub — and a dust payment to
  /// one is worthless to the sender until the mint's wallet SPENDS it. At that
  /// moment the common-input-ownership heuristic attributes every co-input
  /// address to the mint. This records the co-spend so it can be noticed.
  inputTxids       String[] @default([])
  quoteId        String?
  matchedAddress String?
  /// The output index that paid the quote address. With it, the credited check
  /// is an equality lookup on mint_quote_payments' unique payment_id
  /// (`txid:vout`) rather than a prefix scan whose correctness would depend on
  /// the database's collation ordering punctuation the way we assume.
  matchedVout    Int?
  classifiedAt   DateTime?
  classifyError  String?
  /// Bounded so a permanently unlookup-able transaction cannot be retried every
  /// tick forever.
  classifyAttempts Int @default(0)

  /// Set once CDK has booked a payment for matchedVout. Until then the value is
  /// in the wallet but not in the mint's books, which is exactly the gap this
  /// table exists to close.
  creditedAt DateTime?

  @@index([classification])
  @@index([firstObservedAt])
}

/// Discrete observations that are not time series — keyset changes, force-closes,
/// collector failures.
model Event {
  id     Int      @id @default(autoincrement())
  at     DateTime @default(now())
  source String
  kind   String
  detail String?
  context Json?

  @@index([at])
  @@index([kind, at])
}
